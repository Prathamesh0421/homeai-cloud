# HomeAI Cloud — Caddy gateway + SPA host.
# Owner: Renuka (P0-9). Source of truth: docs/03_REPO_AND_INFRA.md section 4.1
# and the routing table in docs/01_ARCHITECTURE.md.
#
# SITE_ADDRESS is ":80" locally and the public domain on EC2 (so Caddy obtains a
# Let's Encrypt certificate automatically). API paths reverse-proxy to the owning
# service; everything else serves the built SPA with history-API fallback.

# Behind the AWS ALB (A-6), keep the client IP the ALB put in X-Forwarded-For instead of
# replacing it with the ALB's address. Only private (VPC) peers are trusted; a client reaching
# Caddy directly still gets its X-Forwarded-For reset to its own address.
{
	servers {
		trusted_proxies static private_ranges
	}
}

# S-2 (docs/08 §4): each API route load-balances over every running copy of its service
# (`docker compose ... --scale c1-iot=2`, infra/docker-compose.scale.yml); with one copy it
# behaves like a plain reverse_proxy.
# - `dynamic a`: the copies are looked up in Docker's DNS every 5 s, so copies that start or stop
#   are picked up. (Active health checks do not run for dynamic upstreams.)
# - A request that cannot reach a copy (connection refused, e.g. a stopped copy still in the
#   5 s DNS cache) is retried on another for up to 5 s; that copy is then skipped for 10 s
#   (passive health). GET requests are also retried if the copy drops the connection.
# - No `unhealthy_status`: C1/C2 answer 503 by design when S3 or another component is down, and
#   counting that would take every copy out of rotation at once.
(api) {
	reverse_proxy {
		dynamic a {args[0]} {args[1]} {
			refresh 5s
		}
		lb_policy least_conn
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 10s
		max_fails 1
	}
}

{$SITE_ADDRESS:":80"} {
	encode gzip

	# C4 owns a couple of house sub-resources that otherwise look like C1 paths.
	@c4houses path_regexp c4houses ^/api/v1/(houses/[^/]+/(settings|emergency-contacts)|emergency-contacts)
	handle @c4houses {
		import api c4-dashboard 8004
	}

	@c4 path /api/v1/auth/* /api/v1/dashboard/* /api/v1/tenants* /api/v1/users/* /.well-known/jwks.json /api/v1/docs/c4* /api/v1/health/c4
	handle @c4 {
		import api c4-dashboard 8004
	}

	@c1 path /api/v1/houses* /api/v1/rooms* /api/v1/feeds* /api/v1/ingest/* /api/v1/clips* /api/v1/docs/c1* /api/v1/health/c1
	handle @c1 {
		import api c1-iot 8001
	}

	@c2 path /api/v1/alerts* /api/v1/alert-rules* /api/v1/alert-types* /api/v1/alert-view/* /api/v1/docs/c2* /api/v1/health/c2
	handle @c2 {
		import api c2-alerts 8002
	}

	@c3 path /api/v1/inference/* /api/v1/media-events/* /api/v1/models* /api/v1/records/* /api/v1/detections/* /api/v1/data-dictionary* /api/v1/integrity-* /api/v1/activity-patterns* /api/v1/docs/c3* /api/v1/health/c3
	handle @c3 {
		import api c3-data 8003
	}

	# Everything else is the SPA.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	request_body {
		max_size 60MB
	}
}

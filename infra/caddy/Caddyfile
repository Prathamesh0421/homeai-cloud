# HomeAI Cloud — Caddy gateway + SPA host.
# Owner: Renuka (P0-9). Source of truth: docs/03_REPO_AND_INFRA.md section 4.1
# and the routing table in docs/01_ARCHITECTURE.md.
#
# SITE_ADDRESS is ":80" locally and the public domain on EC2 (so Caddy obtains a
# Let's Encrypt certificate automatically). API paths reverse-proxy to the owning
# service; everything else serves the built SPA with history-API fallback.

{$SITE_ADDRESS:":80"} {
	encode gzip

	# C4 owns a couple of house sub-resources that otherwise look like C1 paths.
	@c4houses path_regexp c4houses ^/api/v1/(houses/[^/]+/(settings|emergency-contacts)|emergency-contacts)
	handle @c4houses {
		reverse_proxy c4-dashboard:8004
	}

	@c4 path /api/v1/auth/* /api/v1/dashboard/* /api/v1/tenants* /api/v1/users/* /.well-known/jwks.json /api/v1/docs/c4* /api/v1/health/c4
	handle @c4 {
		reverse_proxy c4-dashboard:8004
	}

	@c1 path /api/v1/houses* /api/v1/rooms* /api/v1/feeds* /api/v1/ingest/* /api/v1/clips* /api/v1/docs/c1* /api/v1/health/c1
	handle @c1 {
		reverse_proxy c1-iot:8001
	}

	@c2 path /api/v1/alerts* /api/v1/alert-rules* /api/v1/alert-types* /api/v1/alert-view/* /api/v1/docs/c2* /api/v1/health/c2
	handle @c2 {
		reverse_proxy c2-alerts:8002
	}

	@c3 path /api/v1/inference/* /api/v1/media-events/* /api/v1/models* /api/v1/records/* /api/v1/detections/* /api/v1/data-dictionary* /api/v1/integrity-* /api/v1/activity-patterns* /api/v1/docs/c3* /api/v1/health/c3
	handle @c3 {
		reverse_proxy c3-data:8003
	}

	# Everything else is the SPA.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	request_body {
		max_size 60MB
	}
}

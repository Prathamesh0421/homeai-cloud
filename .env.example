# HomeAI Cloud — local development environment template.
# Copy to `.env` and fill in. Never commit `.env`. No real secrets here.

ENV=local
PUBLIC_BASE_URL=http://localhost:8080
SITE_ADDRESS=:80
DEMO_MODE=1

# AWS / LocalStack
AWS_REGION=us-west-2
AWS_ENDPOINT_URL=http://localstack:4566
# LocalStack accepts any credentials; on AWS leave these unset (the EC2 instance role is used).
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Browser-reachable S3 endpoint for presigned URLs (empty on AWS)
AWS_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=homeai-local

# Inter-service URLs (compose hostnames; for local uvicorn use http://localhost:8004)
JWKS_URL=http://c4-dashboard:8004/.well-known/jwks.json
C4_BASE_URL=http://c4-dashboard:8004
C1_BASE_URL=http://c1-iot:8001
C2_BASE_URL=http://c2-alerts:8002
C3_BASE_URL=http://c3-data:8003

# PostgreSQL (one database, one schema per component)
DATABASE_URL_C1=postgresql+psycopg://c1_app:devpass@postgres:5432/homeai
DATABASE_URL_C2=postgresql+psycopg://c2_app:devpass@postgres:5432/homeai
DATABASE_READER_URL_C2=postgresql+psycopg://c2_reader:devpass@postgres:5432/homeai
DATABASE_URL_C4=postgresql+psycopg://c4_app:devpass@postgres:5432/homeai

# MongoDB
MONGO_URL_C1=mongodb://c1_app:devpass@mongo:27017/homeai
MONGO_URL_C2_READER=mongodb://c2_reader:devpass@mongo:27017/homeai
MONGO_URL_C4=mongodb://c4_app:devpass@mongo:27017/homeai

# C4 JWT signing key (Secrets Manager id; LocalStack locally)
C4_JWT_PRIVATE_KEY_SECRET=homeai/jwt-signing-key

# Service client secrets (used by C4 to authenticate other components)
SERVICE_CLIENT_SECRET_C2=dev-c2-secret
SERVICE_CLIENT_SECRET_C3=dev-c3-secret
SERVICE_CLIENT_SECRET_C4=dev-c4-secret
SERVICE_CLIENT_SECRET_DEVICE=dev-device-secret

# C2 alert-view HMAC
C2_ALERT_VIEW_KEY_SECRET=homeai/alert-view-hmac
# Optional local override of that secret (base64, >= 16 bytes; 32 recommended):
# C2_ALERT_VIEW_KEY=

# Notifier (log locally, sns on AWS)
NOTIFIER=log
# C2 background jobs (NotificationRetry 60 s, ContactSubscriptionSync 5 min); on by default
# C2_JOBS_ENABLED=1

# C3 model directory
C3_MODEL_DIR=/models
